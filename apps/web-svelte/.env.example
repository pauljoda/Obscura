# Server-side URL used by the /api/* catch-all proxy (and a few
# SvelteKit `load` calls) to forward requests SvelteKit does not yet
# own locally to the Fastify service. In dev this points directly at
# Fastify; in the unified Docker image it is localhost:4000.
INTERNAL_API_URL=http://localhost:4000

# Public URLs exposed to the browser. Must be prefixed with PUBLIC_ for
# SvelteKit to expose them via `$env/static/public`. PUBLIC_API_URL
# defaults to "/api" so browser fetchApi calls go same-origin to
# SvelteKit (which either owns the route locally or proxies it to
# Fastify via INTERNAL_API_URL).
PUBLIC_APP_URL=http://localhost:8008
PUBLIC_API_URL=/api
