# Server-side API URL used by SvelteKit `load` functions. In dev points
# directly at the Fastify service; in production (unified Docker image)
# points at localhost:4000 on the same machine.
INTERNAL_API_URL=http://localhost:4000

# Public URLs exposed to the browser. Must be prefixed with PUBLIC_ for
# SvelteKit to expose them via `$env/static/public`.
PUBLIC_APP_URL=http://localhost:8008
PUBLIC_API_URL=http://localhost:4000
