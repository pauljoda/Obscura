{
  "name": "@obscura/web-svelte",
  "version": "0.22.1-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-jassub-assets.mjs",
    "dev": "vite dev --port 8008 --host",
    "prebuild": "node scripts/copy-jassub-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --port 8008",
    "start": "node build/index.js",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "api:generate": "orval --config orval.config.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@obscura/app-core": "workspace:*",
    "@obscura/contracts": "workspace:*",
    "@obscura/db": "workspace:*",
    "@obscura/media-core": "workspace:*",
    "@obscura/ui-svelte": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.6.15",
    "jassub": "2.4.2",
    "postgres": "^3.4.8",
    "vidstack": "^1.12.13"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/geist-sans": "^5.2.5",
    "@lucide/svelte": "^1.8.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "jsdom": "^26.0.0",
    "orval": "8.9.1",
    "svelte": "^5.35.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.4"
  }
}
