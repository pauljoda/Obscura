{
  "name": "obscura",
  "version": "0.21.1",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@obscura/web-svelte --filter=@obscura/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:web-svelte": "pnpm --filter @obscura/web-svelte test:unit",
    "test:e2e": "playwright test",
    "test:ci": "pnpm test:unit && pnpm test:integration && pnpm test:web-svelte",
    "coverage": "pnpm test:unit -- --coverage && pnpm test:integration -- --coverage && pnpm test:web-svelte -- --coverage",
    "docs:dev": "node scripts/docs-site.mjs start",
    "docs:build": "pnpm --filter @obscura/documentation-site build",
    "docs:serve": "node scripts/docs-site.mjs serve",
    "docs:check": "pnpm --filter @obscura/documentation-site typecheck && pnpm --filter @obscura/documentation-site build",
    "dev:seed-scroll": "node scripts/dev/seed-scroll-fixtures.mjs",
    "release:check": "node scripts/release/check-version.mjs",
    "release:cut": "node scripts/release/cut.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.0.1",
    "postgres": "^3.4.8",
    "turbo": "^2.0.14",
    "vitest": "^4.1.4"
  }
}
