{
  "name": "@obscura/db",
  "version": "0.21.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/schema": "./src/schema.ts",
    "./src/lib/*": "./src/lib/*.ts",
    "./drizzle.config": "./drizzle.config.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "tsx ./src/migrate.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@obscura/contracts": "workspace:*",
    "@obscura/media-core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
