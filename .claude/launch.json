{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "infra/docker/docker-compose.yml", "up"],
      "port": 8008,
      "autoPort": false
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["docs:dev"],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@obscura/web-svelte", "exec", "vite", "dev", "--host", "--port", "8011"],
      "port": 8011
    }
  ]
}
