{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Obscura: API",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/apps/backend/src/Obscura.Api/Obscura.Api.csproj",
      "preLaunchTask": "Obscura: Docker Up"
    },
    {
      "name": "Obscura: Worker",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/apps/backend/src/Obscura.Worker/Obscura.Worker.csproj",
      "preLaunchTask": "Obscura: Docker Up"
    },
    {
      "name": "Obscura: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8008",
      "webRoot": "${workspaceFolder}/apps/web-svelte",
      "sourceMaps": true
    },
    {
      "name": "Obscura Docs: Dev Site",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "docs:dev",
        "--",
        "--port",
        "3010",
        "--host",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "(https?://127\\.0\\.0\\.1:3010/Obscura/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Obscura Docs: Preview Build",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "docs:serve",
        "--",
        "--port",
        "3010",
        "--host",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Obscura Docs: Build",
      "serverReadyAction": {
        "pattern": "(https?://127\\.0\\.0\\.1:3010/Obscura/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Obscura: Full Stack",
      "configurations": [
        "Obscura: API",
        "Obscura: Worker"
      ],
      "preLaunchTask": "Obscura: Web Build",
      "stopAll": true
    },
    {
      "name": "Obscura: Full Stack + Chrome",
      "configurations": [
        "Obscura: API",
        "Obscura: Worker",
        "Obscura: Chrome"
      ],
      "preLaunchTask": "Obscura: Web Build",
      "stopAll": true
    }
  ]
}
