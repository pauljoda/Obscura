{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Obscura: Full Stack",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Obscura: Docker Up"
    },
    {
      "name": "Svelte-Only: SvelteKit + Worker (no Fastify, no Next)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--parallel",
        "--filter=@obscura/web-svelte",
        "--filter=@obscura/worker"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "INTERNAL_API_URL": "none"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Obscura: Docker Up",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Web (SvelteKit port): dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@obscura/web-svelte", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Obscura: Docker Up",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "API + Worker: dev (no Next)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "turbo",
        "run",
        "dev",
        "--parallel",
        "--filter=@obscura/api",
        "--filter=@obscura/worker"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Obscura: Docker Up"
    },
    {
      "name": "Web (SvelteKit port): attach (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8009",
      "webRoot": "${workspaceFolder}/apps/web-svelte",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/src/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Svelte-Only + Chrome",
      "configurations": [
        "Svelte-Only: SvelteKit + Worker (no Fastify, no Next)",
        "Web (SvelteKit port): attach (Chrome)"
      ],
      "stopAll": true
    },
    {
      "name": "Web (SvelteKit port): dev + Chrome",
      "configurations": [
        "Web (SvelteKit port): dev",
        "Web (SvelteKit port): attach (Chrome)"
      ],
      "stopAll": true
    },
    {
      "name": "Web (SvelteKit port): Full Stack + Chrome",
      "configurations": [
        "API + Worker: dev (no Next)",
        "Web (SvelteKit port): dev",
        "Web (SvelteKit port): attach (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
