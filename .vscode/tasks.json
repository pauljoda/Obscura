{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Obscura: Docker Up",
      "type": "shell",
      "command": "docker compose -f infra/docker/docker-compose.yml up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Boots the dev Postgres container."
    },
    {
      "label": "Obscura: Web Build",
      "type": "shell",
      "command": "pnpm --filter @obscura/web-svelte build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "detail": "Production-builds the Svelte SPA into apps/web-svelte/build."
    },
    {
      "label": "Obscura: .NET Build",
      "type": "shell",
      "command": "dotnet build apps/backend/Obscura.slnx",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile",
      "detail": "Builds the entire .NET backend solution."
    },
    {
      "label": "Obscura: .NET Test",
      "type": "shell",
      "command": "dotnet test apps/backend/Obscura.slnx",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": "$msCompile",
      "detail": "Runs all .NET backend tests."
    },
    {
      "label": "Obscura: Full Prebuild",
      "dependsOn": [
        "Obscura: Docker Up",
        "Obscura: Web Build",
        "Obscura: .NET Build"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "detail": "Boots Postgres, builds the Svelte SPA, and compiles the .NET backend in parallel — guarantees fresh code on every launch."
    },
    {
      "label": "Obscura Docs: Build",
      "type": "shell",
      "command": "pnpm docs:build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Builds the Docusaurus documentation site."
    }
  ]
}
